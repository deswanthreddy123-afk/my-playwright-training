# ========================================
# Framework Environment Variables
# Copy this file to .env and fill in your values
# ========================================

# Browser & Environment Configuration (Required)
BROWSER=edge
ENV=test
HEADLESS=false

# Application URLs (Required)
BASE_URL=https://sperrydigital.local
BASE_URL_API=https://sperrydigital.local/api

# Authentication Credentials (Required)
USERNAME=autotest
PASSWORD=Password123
USERSINITIALS=AT

# Optional URLs
LOGIN_URL=https://sperrydigital.local/login
ASSET_TRACKER_URL=https://sperrydigital.local/asset-tracker

# Optional Authentication
TEST_USERNAME=autotest
TEST_PASSWORD=Password123
ADMIN_USERNAME=admin@sperrydigital.com
ADMIN_PASSWORD=admin123

# Playwright Browser Information (Auto-populated by Playwright)
# PLAYWRIGHT_BROWSER_NAME=
# PLAYWRIGHT_BROWSER_VERSION=
# PLAYWRIGHT_OS_NAME=
# PLAYWRIGHT_OS_VERSION=

# MCP Server Configuration
MCP_SERVER_URL=http://localhost
MCP_SERVER_PORT=4000
MCP_HEALTH_CHECK_TIMEOUT=30000
MCP_HEALTH_CHECK_RETRIES=30

# Test Environment Configuration
NODE_ENV=test
CI=false
HEADLESS=false

# Browser Configuration
BROWSER=edge
SLOW_MO=0
TIMEOUT=30000

# Reporting & Logging
LOG_LEVEL=info
REPORT_DIR=./playwright-report
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# Database Configuration (optional)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=test_user
# DB_PASSWORD=test_password

# API Configuration (optional)
# API_BASE_URL=https://api.example.com
# API_KEY=your_api_key_here
# API_TIMEOUT=30000

# Feature Flags
ENABLE_MCP=true
ENABLE_VISUAL_REGRESSION=false
ENABLE_ACCESSIBILITY_TESTS=false

# Parallel Execution
WORKERS=1
MAX_FAILURES=0

# Custom Project Variables
PROJECT_NAME=Asset Tracker Test Automation
TEST_DATA_PATH=./test-data
FIXTURES_PATH=./fixtures
