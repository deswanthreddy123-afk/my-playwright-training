{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["node"],
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@utils/*": ["./src/utils/*"],
      "@interfaces/*": ["./src/interfaces/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@browser/*": ["./src/browser/*"],
      "@auth/*": ["./src/auth/*"],
      "@config/*": ["./src/config/*"],
      "@types/*": ["./types/*"],
      "@constants/*": ["./constants/*"],
      "@helper/*": ["./helper/*"]
    }
  },
  "include": ["src", "tests", "types", "playwright.config.ts", "playwright.bdd.config.ts", "constants", "helper", "report"],
  "exclude": ["tests/examples", "src/pages/examples"]
}
